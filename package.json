{
  "name": "kindergarten-flashcards",
  "version": "0.1.0",
  "description": "The alphabet, numbers shapes, colors, fry words (and goo!) in flashcard form. Works offline.",
  "homepage": "https://flashcards.gregrickaby.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregrickaby/kindergarten-flashcards.git"
  },
  "author": "Greg Rickaby <@gregrickaby@gmail.com>",
  "bugs": {
    "url": "https://github.com/gregrickaby/kindergarten-flashcards/issues"
  },
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "next build",
    "clean": "rimraf .next",
    "dev": "npm run clean && next dev",
    "export": "next export",
    "format": "npx prettier '**/*.{js,jsx,ts,tsx,md,mdx,html,css,scss,json,yml}' --write || true",
    "lint": "npm run format && npm run lint:js && npm run lint:md",
    "lint:js": "eslint .",
    "lint:md": "npx markdownlint '**/*.{md,mdx}' --fix",
    "postbuild": "next-sitemap",
    "start": "next start",
    "validate": "npm run lint && tsc --noEmit"
  },
  "dependencies": {
    "gooey-react": "^1.1.0",
    "next": "16.2.6",
    "next-pwa": "^5.6.0",
    "pure-react-carousel": "^1.35.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lefthook": "^2.1.6",
    "markdownlint": "^0.40.0",
    "markdownlint-cli": "^0.48.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8"
  }
}
